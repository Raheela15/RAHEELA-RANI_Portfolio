# GEMINI_API_KEY: Required if server-side Gemini AI features are added later.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Portfolio Public Configuration (Safe for client bundle with VITE_ prefix)
# Replace with your Formspree or Web3Forms endpoint URL for production contact form submissions.
# Example Formspree: https://formspree.io/f/your_form_id
VITE_CONTACT_FORM_ENDPOINT=""

# Optional overrides for contact details
VITE_CONTACT_EMAIL="raheelarani686@gmail.com"
VITE_CONTACT_PHONE="03098205388"
VITE_GITHUB_URL="https://github.com/Raheela15"
VITE_LINKEDIN_URL="https://www.linkedin.com/in/raheelarani/"
